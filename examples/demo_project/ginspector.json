		},
		"res://data/enemies.json": {
			"class": "EnemyData",
			"script": "res://scripts/enemy_data.gd",
			"shape": "array"
		},
		"res://data/items.json": {
			"class": "ItemData",
			"script": "res://scripts/item_data.gd",
			"shape": "dictionary",
			"key_field": "id"
		},
		"res://data/weapons.json": {
			"class": "WeaponData",
			"script": "res://csharp/WeaponData.cs",
			"shape": "dictionary"
		}
	},
	"polymorphism": {}
}
